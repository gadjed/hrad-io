# Settlement Planner — in-game ONNX (not wired yet; training does not need these)
RL_AGENT_ENABLED=false
RL_AGENT_MODEL_PATH=models/rl_agent/policy.onnx

# Ollama (already running locally)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Completion model — decision quality scores (0–10) during RL training
# Must support /api/generate (NOT an embedding-only model)
OLLAMA_MODEL=gemma4:e4b

# Embedding model — optional (similarity / retrieval only; no generate)
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
